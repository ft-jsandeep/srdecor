rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user owns the document or document has no userId (backward compatibility)
    function isOwnerOrNoUserId(resource) {
      return isAuthenticated() && 
             (resource == null || 
              resource.data.userId == null || 
              resource.data.userId == request.auth.uid);
    }
    
    // Bills collection
    match /bills/{document} {
      // Allow read if authenticated and user owns it (or document has no userId for backward compatibility)
      allow read: if isOwnerOrNoUserId(resource);
      // Allow create if authenticated and userId matches
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Allow update if authenticated and user owns it, and userId is preserved
      allow update: if isOwnerOrNoUserId(resource) &&
                     (request.resource.data.userId == null || 
                      request.resource.data.userId == request.auth.uid);
      // Allow delete if authenticated and user owns it
      allow delete: if isOwnerOrNoUserId(resource);
    }
    
    // Estimates collection
    match /estimates/{document} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Items collection
    match /items/{document} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Customers collection
    match /customers/{document} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Business Settings collection
    match /businessSettings/{document} {
      // Allow read (both get and list) for authenticated users who own the document
      allow read: if isAuthenticated() && 
                     (resource == null || resource.data.userId == request.auth.uid);
      // Allow create if authenticated and userId matches
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid;
      // Allow update if authenticated, user owns the document, and userId cannot be changed
      allow update: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid &&
                      request.resource.data.userId == request.auth.uid;
      // Allow delete if authenticated and user owns the document
      allow delete: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
    }
    
    // Payments collection
    match /payments/{document} {
      // Allow read if authenticated and user owns it (or document has no userId for backward compatibility)
      allow read: if isOwnerOrNoUserId(resource);
      // Allow create if authenticated and userId matches
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Allow update if authenticated and user owns it, and userId is preserved
      allow update: if isOwnerOrNoUserId(resource) &&
                     (request.resource.data.userId == null || 
                      request.resource.data.userId == request.auth.uid);
      // Allow delete if authenticated and user owns it
      allow delete: if isOwnerOrNoUserId(resource);
    }
    
    // Quotation Requests collection
    // Allow public to create quotation requests (for lead generation)
    // Only authenticated users can read and update
    match /quotationRequests/{document} {
      // Allow anyone to create (public write for lead generation)
      // No validation needed - frontend handles validation
      allow create: if true;
      // Only authenticated users can read
      allow read: if isAuthenticated();
      // Only authenticated users can update
      allow update: if isAuthenticated();
      // Only authenticated users can delete
      allow delete: if isAuthenticated();
    }
  }
}

